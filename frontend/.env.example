# OneToolHub Frontend Environment Configuration
# Copy this file to .env.local (for local overrides) or configure in your production hosting dashboard.

# Production Canonical Site URL (Must be a valid HTTPS origin without a trailing slash in production)
# Leave unset in local development so canonical URLs and sitemaps do not emit an invented domain.
# Example: NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=
