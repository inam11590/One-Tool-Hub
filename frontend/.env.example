# ==============================================================================
# OneToolHub — Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `frontend/.env.local` for local overrides or configure these
# variables in your Vercel Project Settings -> Environment Variables.
# Never commit real API keys, secret tokens, or production credentials.

# ------------------------------------------------------------------------------
# 1. Canonical Production Site URL & Preview Protection
# ------------------------------------------------------------------------------
# Production HTTPS origin (without a trailing slash).
NEXT_PUBLIC_SITE_URL=https://one-tool-hub-sooty.vercel.app

# ------------------------------------------------------------------------------
# 2. Google Search Console Verification
# ------------------------------------------------------------------------------
# Public verification token for `<meta name="google-site-verification" content="..." />`.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=VzTJTHFVF7UaofXkbpnYPaFnn97slv1Gbq9rjnkw7gY

# ------------------------------------------------------------------------------
# 3. Google Analytics 4 & Privacy Consent
# ------------------------------------------------------------------------------
# Public GA4 Measurement ID matching `G-XXXXXXXXXX`.
# GA4 scripts only load when a valid Measurement ID is set AND the user explicitly
# accepts optional analytics in the privacy consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y6CKKYZDWM

# By default, analytics tracking is disabled in local development (`NODE_ENV !== "production"`).
# Set to "true" only when testing GA4 consent and event flows locally.
NEXT_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false

# ------------------------------------------------------------------------------
# 4. Operational Error Monitoring Hook (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
NEXT_PUBLIC_ERROR_MONITORING_DSN=
