# ==============================================================================
# OneToolHub — Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `frontend/.env.local` for local overrides or configure these
# variables in your Vercel Project Settings -> Environment Variables.
# Never commit real API keys, secret tokens, or production credentials.

# ------------------------------------------------------------------------------
# 1. Canonical Production Site URL & Preview Protection
# ------------------------------------------------------------------------------
# Production HTTPS origin (without a trailing slash).
# - On Vercel Production, if left unset, `src/lib/seo.ts` automatically resolves
#   `VERCEL_PROJECT_PRODUCTION_URL` / `https://one-tool-hub-sooty.vercel.app`.
# - On Vercel Preview deployments (`VERCEL_ENV=preview`), `robots.txt`, page
#   metadata (`noindex, nofollow`), and `X-Robots-Tag` automatically block indexing.
# - In local development (`npm run dev`), leave empty to default to `http://localhost:3000`.
NEXT_PUBLIC_SITE_URL=https://one-tool-hub-sooty.vercel.app

# ------------------------------------------------------------------------------
# 2. Google Search Console Verification (Optional)
# ------------------------------------------------------------------------------
# Optional verification token for `<meta name="google-site-verification" content="..." />`.
# Provide only the token string from Google Search Console (HTML tag method).
# Leave empty if verifying via DNS TXT record or if not yet configured.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# 3. Google Analytics 4 & Privacy Consent (Optional)
# ------------------------------------------------------------------------------
# Optional GA4 Measurement ID matching `G-XXXXXXXXXX`.
# GA4 scripts only load when a valid Measurement ID is set AND the user explicitly
# accepts optional analytics in the privacy consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# By default, analytics tracking is disabled in local development (`NODE_ENV !== "production"`).
# Set to "true" only when testing GA4 consent and event flows locally.
NEXT_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false

# ------------------------------------------------------------------------------
# 4. Operational Error Monitoring Hook (Optional)
# ------------------------------------------------------------------------------
# Enables the privacy-safe client error monitoring hook (`src/lib/error-monitoring.ts`).
# Only generic error categories (e.g., `syntax_error`, `file_too_large`) are reported;
# user inputs, filenames, and raw contents are never logged or transmitted.
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
NEXT_PUBLIC_ERROR_MONITORING_DSN=
