# ==============================================================================
# OneToolHub — Root Environment Configuration Reference (.env.example)
# ==============================================================================
# The Next.js frontend reads environment variables from `frontend/.env.local`
# (see `frontend/.env.example`). Copy this file to `frontend/.env.local` or set
# these variables in your Vercel Project Settings -> Environment Variables.
# Do not commit real secrets or private tokens to version control.

# 1. Canonical Production Site URL
# Defaults automatically to https://one-tool-hub-sooty.vercel.app on Vercel Production
# or http://localhost:3000 in local development. Set explicitly if using a custom domain.
NEXT_PUBLIC_SITE_URL=https://one-tool-hub-sooty.vercel.app

# 2. Google Search Console Verification Token (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Google Analytics 4 Measurement ID & Dev Toggle (Optional, Consent-Gated)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false

# 4. Operational Error Monitoring Hook (Optional)
NEXT_PUBLIC_ERROR_MONITORING_ENABLED=false
NEXT_PUBLIC_ERROR_MONITORING_DSN=
